VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe publishable key (safe to expose in frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Stripe secret key → Supabase Edge Functions Secrets ONLY (never here!)
# supabase secrets set STRIPE_SECRET_KEY=sk_test_...

# ── Genesis Engine (/api/genesis) — SERVER-SIDE ONLY, set in Vercel env vars ──
# Never prefix with VITE_ (that would leak them into the client bundle).
# GEMINI_API_KEY_1=...
# GEMINI_API_KEY_2=...
# GEMINI_API_KEY_3=...
# GEMINI_API_KEY_4=...
# GEMINI_KEY_COUNT=4
# Optional server-side persistence (service role bypasses RLS to log every step):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
